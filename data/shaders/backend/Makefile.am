## Process this file with automake to generate Makefile.in.

## Source files generated by the glsl2h.sh utility (converts .glsl shader
## files to C/C++ header files).

BUILT_SOURCES = \
	BackendUnifiedVertex.h \
	BackendUnifiedFragment.h \
	BackendWideLineVertex.h \
	BackendWideLineGeometry.h \
	BackendWideLineFragment.h \
	BackendWidePointVertex.h \
	BackendWidePointGeometry.h \
	BackendWidePointFragment.h \
	BackendIdPickVertex.h \
	BackendIdPickFragment.h \
	BackendIdPickLineGeometry.h \
	BackendIdPickLineFragment.h

DISTCLEANFILES = \
	$(BUILT_SOURCES) \
	glsl2h.sh

if MAC_FRAMEWORK
shadersbackenddatadir = $(MAC_FRAMEWORK_PREFIX)/$(MAC_FRAMEWORK_NAME).framework/Versions/$(MAC_FRAMEWORK_VERSION)/Resources/shaders/backend
else
shadersbackenddatadir = $(datadir)/Coin/shaders/backend
endif

dist_shadersbackenddata_DATA = \
	BackendUnifiedVertex.glsl \
	BackendUnifiedFragment.glsl \
	BackendWideLineVertex.glsl \
	BackendWideLineGeometry.glsl \
	BackendWideLineFragment.glsl \
	BackendWidePointVertex.glsl \
	BackendWidePointGeometry.glsl \
	BackendWidePointFragment.glsl \
	BackendIdPickVertex.glsl \
	BackendIdPickFragment.glsl \
	BackendIdPickLineGeometry.glsl \
	BackendIdPickLineFragment.glsl

all-local: $(BUILT_SOURCES)

glsl2h.sh: $(srcdir)/../glsl2h.sh.in
	@( cd $(top_builddir); ./config.status --file=data/shaders/backend/glsl2h.sh:data/shaders/glsl2h.sh.in )
	@chmod 755 glsl2h.sh

BackendUnifiedVertex.h: $(srcdir)/BackendUnifiedVertex.glsl glsl2h.sh
	if ./glsl2h.sh $(srcdir)/BackendUnifiedVertex.glsl > $@; then :; else rm -f $@; exit 1; fi

BackendUnifiedFragment.h: $(srcdir)/BackendUnifiedFragment.glsl glsl2h.sh
	if ./glsl2h.sh $(srcdir)/BackendUnifiedFragment.glsl > $@; then :; else rm -f $@; exit 1; fi

BackendWideLineVertex.h: $(srcdir)/BackendWideLineVertex.glsl glsl2h.sh
	if ./glsl2h.sh $(srcdir)/BackendWideLineVertex.glsl > $@; then :; else rm -f $@; exit 1; fi

BackendWideLineGeometry.h: $(srcdir)/BackendWideLineGeometry.glsl glsl2h.sh
	if ./glsl2h.sh $(srcdir)/BackendWideLineGeometry.glsl > $@; then :; else rm -f $@; exit 1; fi

BackendWideLineFragment.h: $(srcdir)/BackendWideLineFragment.glsl glsl2h.sh
	if ./glsl2h.sh $(srcdir)/BackendWideLineFragment.glsl > $@; then :; else rm -f $@; exit 1; fi

BackendWidePointVertex.h: $(srcdir)/BackendWidePointVertex.glsl glsl2h.sh
	if ./glsl2h.sh $(srcdir)/BackendWidePointVertex.glsl > $@; then :; else rm -f $@; exit 1; fi

BackendWidePointGeometry.h: $(srcdir)/BackendWidePointGeometry.glsl glsl2h.sh
	if ./glsl2h.sh $(srcdir)/BackendWidePointGeometry.glsl > $@; then :; else rm -f $@; exit 1; fi

BackendWidePointFragment.h: $(srcdir)/BackendWidePointFragment.glsl glsl2h.sh
	if ./glsl2h.sh $(srcdir)/BackendWidePointFragment.glsl > $@; then :; else rm -f $@; exit 1; fi

BackendIdPickVertex.h: $(srcdir)/BackendIdPickVertex.glsl glsl2h.sh
	if ./glsl2h.sh $(srcdir)/BackendIdPickVertex.glsl > $@; then :; else rm -f $@; exit 1; fi

BackendIdPickFragment.h: $(srcdir)/BackendIdPickFragment.glsl glsl2h.sh
	if ./glsl2h.sh $(srcdir)/BackendIdPickFragment.glsl > $@; then :; else rm -f $@; exit 1; fi

BackendIdPickLineGeometry.h: $(srcdir)/BackendIdPickLineGeometry.glsl glsl2h.sh
	if ./glsl2h.sh $(srcdir)/BackendIdPickLineGeometry.glsl > $@; then :; else rm -f $@; exit 1; fi

BackendIdPickLineFragment.h: $(srcdir)/BackendIdPickLineFragment.glsl glsl2h.sh
	if ./glsl2h.sh $(srcdir)/BackendIdPickLineFragment.glsl > $@; then :; else rm -f $@; exit 1; fi

install-dist_shadersbackenddataDATA: $(dist_shadersbackenddata_DATA)
	@$(NORMAL_INSTALL)
	$(mkinstalldirs) $(DESTDIR)$(shadersbackenddatadir)
	@list='$(dist_shadersbackenddata_DATA)'; for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  f="`echo $$p | sed -e 's|^.*/||'`"; \
	  if cmp -s "$$d$$p" "$(DESTDIR)$(shadersbackenddatadir)/$$f"; then :; else \
	    echo " $(INSTALL_DATA) $$d$$p $(DESTDIR)$(shadersbackenddatadir)/$$f"; \
	    $(INSTALL_DATA) "$$d$$p" "$(DESTDIR)$(shadersbackenddatadir)/$$f"; \
	  fi \
	done
